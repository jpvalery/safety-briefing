---
import "../styles/global.css";
import {
	defaultLocale,
	type Locale,
	locales,
	ogLocales,
	useTranslations,
} from "../i18n";

interface Props {
	locale: Locale;
	noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const t = useTranslations(locale);

const site = Astro.site ?? new URL("https://safety-briefing.com");
const url = (l: Locale) => new URL(`/${l}`, site).href;
const canonical = url(locale);
const ogImage = new URL("/og.png", site).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${site.origin}/#website`,
			url: site.origin,
			name: "Safety Briefing",
			inLanguage: locales,
		},
		{
			"@type": "WebPage",
			"@id": `${canonical}#webpage`,
			url: canonical,
			name: t.seoTitle,
			description: t.description,
			inLanguage: locale,
			isPartOf: { "@id": `${site.origin}/#website` },
			primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
			audience: { "@type": "Audience", audienceType: "Aircraft passengers" },
			about: { "@type": "Thing", name: "General aviation passenger safety" },
			hasPart: [
				{
					"@type": "WebPageElement",
					"@id": `${canonical}#before-flying`,
					name: t.beforeFlying,
				},
				{
					"@type": "WebPageElement",
					"@id": `${canonical}#passenger-briefing`,
					name: t.passengerBriefing,
				},
			],
		},
	],
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.seoTitle}</title>
		<meta name="description" content={t.description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		{locales.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
		<link rel="alternate" hreflang="x-default" href={url(defaultLocale)} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#ffffff" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Safety Briefing" />
		<meta property="og:title" content={t.seoTitle} />
		<meta property="og:description" content={t.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocales[locale]} />
		{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={t.seoTitle} />
		<meta name="twitter:description" content={t.description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
		>
			{t.skipToContent}
		</a>
		<slot />
	</body>
</html>
