---
import type { Locale } from "../i18n";
import { useTranslations } from "../i18n";
import LanguageSwitcher from "./language-switcher.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header class="border-b-2 border-line bg-card py-6 print:py-2">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<h1 class="text-balance font-bold text-2xl uppercase tracking-wide md:text-4xl print:text-xl">{t.title}</h1>
		<LanguageSwitcher locale={locale} />
	</div>
</header>
