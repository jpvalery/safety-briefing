---
import { defaultLocale, languageNames, locales } from "../i18n";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout locale={defaultLocale} noindex>
	<main id="main" class="mx-auto max-w-2xl px-4 py-24 text-center">
		<h1 class="mb-6 font-bold text-4xl uppercase">404</h1>
		<ul class="flex flex-wrap justify-center gap-3">
			{locales.map((l) => <li><a class="border-2 border-line px-4 py-2 hover:bg-accent hover:text-accent-ink" href={`/${l}`} lang={l}>{languageNames[l]}</a></li>)}
		</ul>
	</main>
</BaseLayout>
